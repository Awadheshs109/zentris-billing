{
  "name": "@awadheshs109/billing",
  "version": "2.0.7",
  "description": "Framework-independent TypeScript billing library for Angular, React, Vue, Node.js and JavaScript projects",
  "author": "Awadhesh Sharma",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint .",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s"
  },
  "keywords": [
    "billing",
    "invoice",
    "gst",
    "tax",
    "typescript",
    "javascript",
    "react",
    "angular",
    "vue",
    "nodejs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Awadheshs109/zentris-billing.git"
  },
  "bugs": {
    "url": "https://github.com/Awadheshs109/zentris-billing/issues"
  },
  "homepage": "https://github.com/Awadheshs109/zentris-billing",
  "devDependencies": {
    "@types/node": "^24.10.1",
    "conventional-changelog-cli": "^5.0.0",
    "eslint": "^9.39.1",
    "tsup": "^8.5.1",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.3",
    "papaparse": "^5.5.3",
    "puppeteer": "^24.43.1"
  }
}
